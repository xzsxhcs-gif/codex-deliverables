    "fake-indexeddb": "^6.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
