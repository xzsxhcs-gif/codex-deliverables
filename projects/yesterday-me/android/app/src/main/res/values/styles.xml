<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#111214</item>
        <item name="colorPrimaryDark">#111214</item>
        <item name="colorAccent">#f79a53</item>
    </style>
    <style name="BaseAppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#111214</item>
        <item name="android:navigationBarColor">#111214</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="BaseAppTheme.NoActionBar" />
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">#111214</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
